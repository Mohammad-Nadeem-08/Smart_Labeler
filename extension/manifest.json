{
  "manifest_version": 3,
  "name": "Smart Labeler",
  "version": "1.0",
  "description": "AI-powered Gmail email classifier and keyword highlighter.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:3000/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Labeler"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}